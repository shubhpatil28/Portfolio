# Resend Email API Key (Required)
# Generate from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Optional: Verified sender address (defaults to onboarding@resend.dev)
# Note: onboarding@resend.dev only delivers to the email address registered with your Resend account.
# To send to external visitors, verify your domain in Resend and set this variable.
# RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>

# Firebase Admin SDK Credentials (Required for Persistent Firestore Protection)
# Project ID: shubhfolio-backend
# You can provide credentials using EITHER Option A (single string) OR Option B (individual fields).

# Option A: Full Service Account JSON content (or Base64 encoded JSON string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"shubhfolio-backend","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@shubhfolio-backend.iam.gserviceaccount.com"}

# Option B: Individual Service Account fields (alternative to Option A)
# FIREBASE_PROJECT_ID=shubhfolio-backend
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@shubhfolio-backend.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"